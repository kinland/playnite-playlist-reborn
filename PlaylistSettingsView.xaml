<UserControl x:Class="Playlist.PlaylistSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="520">
    <StackPanel Margin="12">
        <TextBlock
            Margin="0,0,0,4"
            Text="{Binding LanguageOverrideLabel}" />
        <ComboBox
            x:Name="languageOverrideComboBox"
            Margin="0,0,0,12"
            DisplayMemberPath="DisplayName"
            SelectedValuePath="LocaleId"
            SelectedValue="{Binding LanguageOverrideComboValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding LanguageOptions}"
            SelectionChanged="LanguageOverrideComboBox_SelectionChanged" />
        <!--
            Per-column visibility is toggled by right-clicking the column headers in the playlist view.
            The HowLongToBeat integration toggle stays here because it also gates reading the HowLongToBeat
            plugin's data, not just column visibility.
        -->
        <CheckBox
            x:Name="enableHowLongToBeatIntegrationCheckBox"
            VerticalAlignment="Center"
            IsChecked="{Binding HowLongToBeatIntegrationCheckboxDisplay, Mode=TwoWay}"
            IsEnabled="True"
            PreviewMouseLeftButtonDown="EnableHowLongToBeatIntegrationCheckBox_PreviewMouseLeftButtonDown"
            Content="{DynamicResource LOCPlaylist_Settings_EnableHLTBIntegration}">
            <CheckBox.Style>
                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHowLongToBeatAvailable}" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Hand" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsHowLongToBeatAvailable}" Value="False" />
                                <Condition Binding="{Binding IsHowLongToBeatInstalledDisabled}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="ToolTip" Value="{DynamicResource LOCPlaylist_HLTB_OpenAddonsToEnable}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsHowLongToBeatAvailable}" Value="False" />
                                <Condition Binding="{Binding IsHowLongToBeatNotInstalled}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="ToolTip" Value="{DynamicResource LOCPlaylist_HLTB_OpenAddonsToInstall}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </CheckBox.Style>
        </CheckBox>

        <StackPanel Margin="24,8,0,8">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowHltbCompletionStatusSyncSection}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <CheckBox
                Margin="0,0,0,8"
                IsChecked="{Binding SyncCompletionStatusWithHltb}"
                Content="{DynamicResource LOCPlaylist_Settings_SyncCompletionStatusWithHltb}" />

            <TextBlock
                Margin="0,0,0,8"
                TextWrapping="Wrap"
                Opacity="0.85"
                Text="{DynamicResource LOCPlaylist_Settings_HLTBStatusSyncHelp}" />

            <Grid Margin="0,0,0,4">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SyncCompletionStatusWithHltb}" Value="True">
                                <Setter Property="IsEnabled" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Opacity="0.8"
                           Text="{DynamicResource LOCPlaylist_Settings_HLTBStatusSyncPlayniteColumn}" />
                <TextBlock Grid.Row="0" Grid.Column="4" Opacity="0.8"
                           Text="{DynamicResource LOCPlaylist_Settings_HLTBStatusSyncTargetColumn}" />

                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                           Text="{DynamicResource LOCPlaylist_Settings_HLTBStatusSyncPlayingRow}" />
                <ComboBox Grid.Row="2" Grid.Column="2"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          ItemsSource="{Binding HltbSyncConfigurableCompletionStatusOptions}"
                          SelectedValue="{Binding HltbSyncStatusPlayingId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="2" Grid.Column="4" VerticalAlignment="Center"
                           Text="{DynamicResource LOCPlaylist_Settings_HLTBStatusSyncTargetPlaying}" />

                <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"
                           Text="{DynamicResource LOCPlaylist_Settings_HLTBStatusSyncCompletedRow}" />
                <ComboBox Grid.Row="4" Grid.Column="2"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          ItemsSource="{Binding HltbSyncConfigurableCompletionStatusOptions}"
                          SelectedValue="{Binding HltbSyncStatusCompletedId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="4" Grid.Column="4" VerticalAlignment="Center"
                           Text="{DynamicResource LOCPlaylist_Settings_HLTBStatusSyncTargetBeaten}" />

                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"
                           Text="{DynamicResource LOCPlaylist_Settings_HLTBStatusSyncCompletionistRow}" />
                <ComboBox Grid.Row="6" Grid.Column="2"
                          DisplayMemberPath="Name"
                          SelectedValuePath="Id"
                          ItemsSource="{Binding HltbSyncConfigurableCompletionStatusOptions}"
                          SelectedValue="{Binding HltbSyncStatusCompletionistId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="6" Grid.Column="4" VerticalAlignment="Center"
                           Text="{DynamicResource LOCPlaylist_Settings_HLTBStatusSyncTargetCompleted}" />

                <TextBlock Grid.Row="8" Grid.Column="0" VerticalAlignment="Center"
                           Text="{Binding HltbSyncStatusBacklogDisplayName}" />
                <TextBlock Grid.Row="8" Grid.Column="4" VerticalAlignment="Center"
                           Text="{Binding HltbSyncStatusBacklogTargetLabel}" />
            </Grid>
        </StackPanel>

        <CheckBox
            VerticalAlignment="Center"
            Margin="0,0,0,8"
            IsChecked="{Binding SyncSearchWithMainPanel}"
            Content="{Binding SyncSearchWithMainPanelLabel}" />
    </StackPanel>
</UserControl>
