<UserControl x:Class="Playlist.PlaylistSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="280" d:DesignWidth="400">
    <StackPanel Margin="12">
        <TextBlock
            Margin="0,0,0,4"
            Text="{DynamicResource LOCPlaylist_Settings_LanguageOverride}" />
        <ComboBox
            x:Name="languageOverrideComboBox"
            Margin="0,0,0,12"
            DisplayMemberPath="DisplayName"
            SelectedValuePath="LocaleId"
            SelectedValue="{Binding LanguageOverrideComboValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ItemsSource="{Binding LanguageOptions}"
            SelectionChanged="LanguageOverrideComboBox_SelectionChanged" />
        <!--
            Per-column visibility is toggled by right-clicking the column headers in the playlist view.
            The HowLongToBeat integration toggle stays here because it also gates reading the HowLongToBeat
            plugin's data, not just column visibility.
        -->
        <CheckBox
            x:Name="enableHowLongToBeatIntegrationCheckBox"
            VerticalAlignment="Center"
            IsChecked="{Binding HowLongToBeatIntegrationCheckboxDisplay, Mode=TwoWay}"
            IsEnabled="True"
            PreviewMouseLeftButtonDown="EnableHowLongToBeatIntegrationCheckBox_PreviewMouseLeftButtonDown"
            Content="{DynamicResource LOCPlaylist_Settings_EnableHLTBIntegration}">
            <CheckBox.Style>
                <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsHowLongToBeatAvailable}" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter Property="Cursor" Value="Hand" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsHowLongToBeatAvailable}" Value="False" />
                                <Condition Binding="{Binding IsHowLongToBeatInstalledDisabled}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="ToolTip" Value="{DynamicResource LOCPlaylist_HLTB_OpenAddonsToEnable}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsHowLongToBeatAvailable}" Value="False" />
                                <Condition Binding="{Binding IsHowLongToBeatNotInstalled}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="ToolTip" Value="{DynamicResource LOCPlaylist_HLTB_OpenAddonsToInstall}" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </CheckBox.Style>
        </CheckBox>
        <CheckBox
            VerticalAlignment="Center"
            Margin="0,0,0,8"
            IsChecked="{Binding SyncSearchWithMainPanel}"
            Content="{DynamicResource LOCPlaylist_Settings_SyncSearchWithMainPanel}" />
    </StackPanel>
</UserControl>
