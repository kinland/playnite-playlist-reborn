<UserControl x:Class="Playlist.PlaylistView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:local="clr-namespace:Playlist"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">

    <UserControl.Resources>
        <local:GamePlaylistRankConverter x:Key="gamePlaylistRankConverter" />
        <local:LastPlayedValueConverter x:Key="lastPlayedValueConverter" />
        <local:LastActivityValueConverter x:Key="lastActivityValueConverter" />
        <local:PlaytimeValueConverter x:Key="playtimeValueConverter" />

        <!-- Keep in sync with PlaylistGridViewLayout.cs (x:Static cannot reference internal types). -->
        <Thickness x:Key="PlaylistHeaderChromeMargin">1</Thickness>
        <!-- Icon column: 38px slot (artwork width). Horizontal header/body offset applied on row presenter. -->
        <Thickness x:Key="PlaylistIconColumnChromeMargin">0,1,0,1</Thickness>
        <sys:Double x:Key="PlaylistIconArtworkSize">38</sys:Double>
        <sys:Double x:Key="PlaylistIconColumnWidth">38</sys:Double>
        <!-- Keep in sync with PlaylistGridViewLayout.cs -->
        <sys:Double x:Key="HltbSegmentStripHeight">22</sys:Double>
        <sys:Double x:Key="HltbCellBlockHeight">30</sys:Double>

        <Style x:Key="noGamesText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}">
            <!-- Show instructions if no games in playlist -->
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlaylistGames.Count}" Value="0">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="visibleIfOneGameSelected_MenuItem" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItems.Count, Source={x:Reference Name=playlistListView}}" Value="1">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="visibleIfOneGameSelected_Separator" TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItems.Count, Source={x:Reference Name=playlistListView}}" Value="1">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="playlistListViewItemTemplate" TargetType="{x:Type ListViewItem}">
            <!-- Row height must fit IconArtworkSize; host ListViewItem chrome may cap effective row height. -->
            <Border
                x:Name="RowBorder"
                Padding="{TemplateBinding Padding}"
                Background="Transparent"
                MinHeight="{StaticResource PlaylistIconArtworkSize}"
                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                <local:PlaylistGridViewRowPresenter
                    Margin="{Binding GridViewRowPresenterMargin, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                    VerticalAlignment="Stretch" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <Trigger Property="Selector.IsSelected" Value="True">
                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource GlyphBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="playlistListViewItemStyle" TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
            <!-- Override host ListViewItem margin/padding so cells use full column width. -->
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Margin" Value="0" />
            <!-- Let each GridView cell use the full column width (needed for rank hit-testing + centering). -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="{StaticResource PlaylistIconArtworkSize}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template" Value="{StaticResource playlistListViewItemTemplate}" />
            <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick"/>

            <Setter Property="ContextMenu">
                <!-- Only set the ContextMenu for ListViewItems to avoid a ContextMenu on the header -->
                <Setter.Value>
                    <ContextMenu>
                        <MenuItem
                            InputGestureText="{Binding DataContext.StartGameCommand.GestureText, Source={x:Reference Name=playlistListView}}"
                            Command="{Binding DataContext.StartGameCommand, Source={x:Reference Name=playlistListView}}"
                            CommandParameter="{Binding}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource visibleIfOneGameSelected_MenuItem}">
                                    <Setter Property="Header" Value="{DynamicResource LOCPlayGame}" />
                                    <Setter Property="Icon" Value="{DynamicResource PlayIcon}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="False" >
                                            <Setter Property="Header" Value="{DynamicResource LOCInstallGame}" />
                                            <Setter Property="Icon" Value="{DynamicResource InstallIcon}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <Separator Style="{StaticResource visibleIfOneGameSelected_Separator}" />
                        <MenuItem
                            Header="{DynamicResource LOCPlaylist_ShowInLibrary}"
                            Icon="{DynamicResource SidebarLibraryIcon}"
                            Command="{Binding DataContext.ShowGameInLibraryCommand, Source={x:Reference Name=playlistListView}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource visibleIfOneGameSelected_MenuItem}" />
                        <Separator Style="{StaticResource visibleIfOneGameSelected_Separator}"/>
                        <MenuItem Header="{DynamicResource LOCSetCompletionStatus}" ItemsSource="{Binding DataContext.CompletionStatusCommands, Source={x:Reference Name=playlistListView}}">
                            <MenuItem.ItemContainerStyle>
                                <Style TargetType="MenuItem">
                                    <Setter Property="Header" Value="{Binding Key.Name}"/>
                                    <Setter Property="Command" Value="{Binding Value}"/>
                                    <Setter Property="CommandParameter" Value="{Binding SelectedItems, Source={x:Reference Name=playlistListView}}" />
                                </Style>
                            </MenuItem.ItemContainerStyle>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Header="{DynamicResource LOCPlaylist_MoveToTop}"
                            Command="{Binding DataContext.MoveGamesToTopCommand, Source={x:Reference Name=playlistListView}}"
                            CommandParameter="{Binding SelectedItems, Source={x:Reference Name=playlistListView}}" />
                        <MenuItem
                            Header="{DynamicResource LOCPlaylist_MoveToBottom}"
                            Command="{Binding DataContext.MoveGamesToBottomCommand, Source={x:Reference Name=playlistListView}}"
                            CommandParameter="{Binding SelectedItems, Source={x:Reference Name=playlistListView}}" />
                        <Separator />
                        <MenuItem
                            Header="{DynamicResource LOCPlaylist_RemoveFromPlaylist}"
                            Icon="{DynamicResource RemoveGameIcon}"
                            InputGestureText="{Binding DataContext.RemoveGamesCommand.GestureText, Source={x:Reference Name=playlistListView}}"
                            Command="{Binding DataContext.RemoveGamesCommand, Source={x:Reference Name=playlistListView}}"
                            CommandParameter="{Binding SelectedItems, Source={x:Reference Name=playlistListView}}" />
                    </ContextMenu>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsInstalled}" Value="False" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <!-- Dim inherited foreground instead of a fixed brush so uninstalled rows stay readable on any canvas. -->
                    <Setter Property="Opacity" Value="0.55" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="playlistIconPlayButtonStyleThemed" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Content" Value="&#xec74;" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource FontIcoFont}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsMouseOver}" Value="True">
                    <!-- Show button on ListViewItem row mouseover -->
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsInstalled}" Value="False" >
                    <!-- Show down arrow for uninstalled games -->
                    <Setter Property="FontSize" Value="30" />
                    <Setter Property="Content" Value="&#xea5b;" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                    <!-- Show circular arrow for launching games -->
                    <Setter Property="FontSize" Value="19" />
                    <Setter Property="Content" Value="&#xec80;" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsUninstalling}" Value="True">
                    <!-- Show circular arrow for uninstalling games -->
                    <Setter Property="FontSize" Value="19" />
                    <Setter Property="Content" Value="&#xec80;" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsInstalling}" Value="True">
                    <!-- Show circular arrow for installing games -->
                    <Setter Property="FontSize" Value="19" />
                    <Setter Property="Content" Value="&#xec80;" />
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>

                <MultiDataTrigger>
                    <!-- Show button and set IsDefault on the selected item, but only if one item is selected -->
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListViewItem}}, Path=IsSelected}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListView}}, Path=SelectedItems.Count}" Value="1" />
                    </MultiDataTrigger.Conditions>
                    <MultiDataTrigger.Setters>
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="IsDefault" Value="True" />
                    </MultiDataTrigger.Setters>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Minimal template so managed row-highlight chrome is not overridden (see docs/row-highlight-chrome-investigation.md). -->
        <Style x:Key="playlistIconPlayButtonStyleManaged" TargetType="Button" BasedOn="{StaticResource playlistIconPlayButtonStyleThemed}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.FontFamily="{TemplateBinding FontFamily}"
                                TextElement.FontSize="{TemplateBinding FontSize}"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="imageIcon" TargetType="Image">
            <!-- Set the image icon visiblity to the inverse of the button's visiblity -->
            <Setter Property="Visibility" Value="Hidden" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Canvas}}, Path=Children[1].Visibility}" Value="Hidden">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="howLongToBeatColumn" DataType="GridViewColumn.CellTemplate">
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Grid
                    Height="{StaticResource HltbCellBlockHeight}"
                    VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="48" />
                </Grid.ColumnDefinitions>
                <local:HowLongToBeatCachedProgressBar
                    Grid.Column="0"
                    Margin="0,0,4,0"
                    MinWidth="60"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />
                <local:HowLongToBeatPluginButtonHost
                    Grid.Column="1"
                    Width="44"
                    Height="{StaticResource HltbCellBlockHeight}"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    DataContext="{Binding}"
                    IsDragReorderSuspended="{Binding DataContext.IsPlaylistDragReorderActive, RelativeSource={RelativeSource AncestorType=ListView}}" />
                </Grid>
            </Grid>
        </DataTemplate>

    </UserControl.Resources>
 
    <DockPanel>
        <Grid Margin="10,10,10,0" DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Hyperlink Command="{Binding NavigateBackCommand}">
                        <TextBlock Text="&#xea5c;" FontFamily="{DynamicResource FontIcoFont}"
                            FontSize="26" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Text="{DynamicResource LOCPlaylist_Playlist}" VerticalAlignment="Center"
                    Style="{StaticResource BaseTextBlockStyle}"
                    Margin="10,0,0,0" FontSize="18"/>
                <Grid Width="360" Margin="28,0,0,0" VerticalAlignment="Center">
                    <TextBox
                        x:Name="playlistSearchTextBox"
                        VerticalAlignment="Center"
                        Padding="28,4,28,4"
                        BorderThickness="1"
                        PreviewKeyDown="OnPlaylistSearchTextBoxPreviewKeyDown"
                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                        ToolTip="{DynamicResource LOCPlaylist_SearchTooltip}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Text="&#xE721;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Foreground="{Binding Foreground, ElementName=playlistSearchTextBox}" />
                    <ContentControl
                        x:Name="playlistSearchClearButton"
                        Margin="0,2,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Cursor="Hand"
                        MouseLeftButtonUp="OnPlaylistSearchClearClick"
                        Content=""
                        ContentTemplate="{DynamicResource ClearTextIconTemplate}"
                        Foreground="{Binding Foreground, ElementName=playlistSearchTextBox}"
                        ToolTip="{DynamicResource LOCPlaylist_SearchClearTooltip}">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.8" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Grid>
            </StackPanel>
        </Grid>

        <ListView
            x:Name="playlistListView"
            ItemsSource="{Binding PlaylistGamesView}"
            ItemContainerStyle="{StaticResource playlistListViewItemStyle}"
            DockPanel.Dock="Top"
            Margin="0,10,0,0"
            BorderThickness="0"
            HorizontalContentAlignment="Stretch"
            ScrollViewer.CanContentScroll="True"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling"
            SelectedIndex="0"
            dd:DragDrop.IsDragSource="{Binding IsDragInteractionEnabled}"
            dd:DragDrop.IsDropTarget="{Binding IsDragInteractionEnabled}"
            dd:DragDrop.DragHandler="{Binding PlaylistDragHandler}"
            dd:DragDrop.DropHandler="{Binding PlaylistDropHandler}"
            GridViewColumnHeader.Click="OnPlaylistGridViewColumnHeaderClick"
            PreviewMouseRightButtonUp="OnPlaylistHeaderPreviewMouseRightButtonUp">

            <ListView.Resources>
                <Style TargetType="GridViewRowPresenter">
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0" />
                </Style>

                <Style TargetType="{x:Type GridViewColumnHeader}" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                    <Style.Triggers>
                        <Trigger Property="Role" Value="Padding">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Width" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MaxWidth" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <!-- HoverBg = border chrome; hover + active-sort fills are applied in RefreshSortHeaderVisualState. -->
                <ControlTemplate x:Key="playlistSortableColumnHeaderTemplate" TargetType="{x:Type GridViewColumnHeader}">
                    <Grid Margin="{StaticResource PlaylistHeaderChromeMargin}">
                        <Border
                            x:Name="HoverBg"
                            BorderThickness="1"
                            Height="28"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource NormalBorderBrush}" />
                        <TextBlock
                            x:Name="ColumnHeader"
                            Style="{DynamicResource BaseTextBlockStyle}"
                            VerticalAlignment="Center"
                            Margin="8,0,8,0">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </TextBlock>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Margin="0,0,-10,0">
                            <Thumb.Style>
                                <Style TargetType="Thumb">
                                    <Setter Property="Width" Value="20" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <Rectangle HorizontalAlignment="Center" Width="1" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Thumb.Style>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource DarkControlBorderBrush}" TargetName="HoverBg" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" TargetName="HoverBg" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

                <ControlTemplate x:Key="playlistNonsortableColumnHeaderTemplate" TargetType="{x:Type GridViewColumnHeader}">
                    <Grid Margin="{StaticResource PlaylistHeaderChromeMargin}">
                        <Border
                            x:Name="HoverBg"
                            BorderThickness="1"
                            Height="28"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource NormalBorderBrush}" />
                        <TextBlock
                            x:Name="ColumnHeader"
                            Style="{DynamicResource BaseTextBlockStyle}"
                            VerticalAlignment="Center"
                            Margin="8,0,8,0">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </TextBlock>
                        <Thumb x:Name="PART_HeaderGripper" HorizontalAlignment="Right" Margin="0,0,-10,0">
                            <Thumb.Style>
                                <Style TargetType="Thumb">
                                    <Setter Property="Width" Value="20" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                    <Rectangle HorizontalAlignment="Center" Width="1" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Thumb.Style>
                        </Thumb>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource DarkControlBorderBrush}" TargetName="HoverBg" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" TargetName="HoverBg" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

                <!-- Icon column header: no left inset so row icons align with the rank/icon column divider. -->
                <ControlTemplate x:Key="playlistIconColumnHeaderTemplate" TargetType="{x:Type GridViewColumnHeader}">
                    <Grid Margin="{StaticResource PlaylistIconColumnChromeMargin}">
                        <Border
                            x:Name="HoverBg"
                            HorizontalAlignment="Left"
                            Width="{StaticResource PlaylistIconArtworkSize}"
                            BorderThickness="1"
                            Height="28"
                            CornerRadius="{DynamicResource ControlCornerRadius}"
                            BorderBrush="{DynamicResource NormalBorderBrush}" />
                        <TextBlock
                            x:Name="ColumnHeader"
                            Style="{DynamicResource BaseTextBlockStyle}"
                            VerticalAlignment="Center"
                            Margin="8,0,8,0">
                            <ContentPresenter
                                VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </TextBlock>
                        <Thumb x:Name="PART_HeaderGripper" Visibility="Collapsed" IsHitTestVisible="False" Width="0" Height="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource DarkControlBorderBrush}" TargetName="HoverBg" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" TargetName="HoverBg" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

                <Style x:Key="sortableHeaderContainerStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template" Value="{StaticResource playlistSortableColumnHeaderTemplate}" />
                </Style>

                <!-- Uniform inset: top = right = bottom (see PlaylistSortHeaderLayout.SortHeaderGlyphInset). -->
                <Style x:Key="sortHeaderGlyphStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Margin" Value="0,2,2,2" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="LineHeight" Value="12" />
                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Text" Value="▲" />
                </Style>

                <!-- Active-sort column highlight (background + border) is applied in RefreshSortHeaderVisualState. -->
                <Style x:Key="rankHeaderContainerStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource sortableHeaderContainerStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                </Style>

                <Style x:Key="nameHeaderContainerStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource sortableHeaderContainerStyle}" />

                <Style x:Key="playtimeHeaderContainerStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource sortableHeaderContainerStyle}" />

                <Style x:Key="completionHeaderContainerStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource sortableHeaderContainerStyle}" />

                <Style x:Key="lastPlayedHeaderContainerStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource sortableHeaderContainerStyle}" />

                <Style x:Key="lastActivityHeaderContainerStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource sortableHeaderContainerStyle}" />

                <Style x:Key="howLongToBeatHeaderContainerStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource sortableHeaderContainerStyle}" />

                <Style x:Key="nonsortableHeaderContainerStyle" TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Template" Value="{StaticResource playlistNonsortableColumnHeaderTemplate}" />
                </Style>

                <Style x:Key="iconHeaderContainerStyle" TargetType="GridViewColumnHeader">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="Template" Value="{StaticResource playlistIconColumnHeaderTemplate}" />
                </Style>

                <DataTemplate x:Key="rankHeaderTemplate">
                    <Grid HorizontalAlignment="Stretch" Margin="0,2,0,2">
                        <TextBlock Tag="RankHeaderHash" Text="#" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontStyle" Value="Normal" />
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Tag="RankHeaderGlyph" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource sortHeaderGlyphStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="Rank">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="Rank" />
                                                <Condition Binding="{Binding DataContext.ActiveViewSortDirection, Source={x:Reference playlistListView}}" Value="Descending" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="▼" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="nameHeaderTemplate">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="6,2,0,2" Text="{DynamicResource LOCNameLabel}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="Name">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource sortHeaderGlyphStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="Name">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="Name" />
                                                <Condition Binding="{Binding DataContext.ActiveViewSortDirection, Source={x:Reference playlistListView}}" Value="Descending" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="▼" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="playtimeHeaderTemplate">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="6,2,0,2" Text="{DynamicResource LOCTimePlayed}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="Playtime">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource sortHeaderGlyphStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="Playtime">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="Playtime" />
                                                <Condition Binding="{Binding DataContext.ActiveViewSortDirection, Source={x:Reference playlistListView}}" Value="Descending" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="▼" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="completionHeaderTemplate">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="6,2,0,2" Text="{DynamicResource LOCCompletionStatus}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="CompletionStatus">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource sortHeaderGlyphStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="CompletionStatus">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="CompletionStatus" />
                                                <Condition Binding="{Binding DataContext.ActiveViewSortDirection, Source={x:Reference playlistListView}}" Value="Descending" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="▼" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="lastPlayedHeaderTemplate">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="6,2,0,2" Text="{DynamicResource LOCPlaylist_LastPlayedColumn}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="LastPlayed">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource sortHeaderGlyphStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="LastPlayed">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="LastPlayed" />
                                                <Condition Binding="{Binding DataContext.ActiveViewSortDirection, Source={x:Reference playlistListView}}" Value="Descending" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="▼" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="lastActivityHeaderTemplate">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Margin="6,2,0,2" Text="{DynamicResource LOCPlaylist_LastActivityColumn}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Normal" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="LastActivity">
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource sortHeaderGlyphStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="LastActivity">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="LastActivity" />
                                                <Condition Binding="{Binding DataContext.ActiveViewSortDirection, Source={x:Reference playlistListView}}" Value="Descending" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="▼" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>

                <DataTemplate x:Key="howLongToBeatHeaderTemplate">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="6,2,0,2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.HowLongToBeatHeaderText, Source={x:Reference playlistListView}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="HowLongToBeat">
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Margin="2,0,0,0" Text="{Binding DataContext.HowLongToBeatHeaderSuffixText, Source={x:Reference playlistListView}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="HowLongToBeat">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="FontWeight" Value="Bold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=GridViewColumnHeader}}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Grid.Column="1">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource sortHeaderGlyphStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="HowLongToBeat">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding DataContext.ActiveViewSortColumn, Source={x:Reference playlistListView}}" Value="HowLongToBeat" />
                                                <Condition Binding="{Binding DataContext.ActiveViewSortDirection, Source={x:Reference playlistListView}}" Value="Descending" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="▼" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListView.Resources>

            <ListView.InputBindings>
                <KeyBinding
                    Key="Delete"
                    Command="{Binding RemoveGamesCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListView}}, Path=SelectedItems}" />
            </ListView.InputBindings>

            <ListView.View>
                <GridView>
                    <GridViewColumn
                        x:Name="rankGridViewColumn"
                        HeaderTemplate="{StaticResource rankHeaderTemplate}"
                        HeaderContainerStyle="{StaticResource rankHeaderContainerStyle}"
                        Width="56">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"
                                    Tag="PlaylistRankCell"
                                    MouseLeftButtonDown="OnRankCellMouseLeftButtonDown">
                                    <TextBlock
                                        Cursor="Hand"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,2,0">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource gamePlaylistRankConverter}">
                                                <Binding />
                                                <Binding Path="DataContext.PlaylistGames" RelativeSource="{RelativeSource AncestorType=ListView}" />
                                                <Binding Path="DataContext.PlaylistGamesRevision" RelativeSource="{RelativeSource AncestorType=ListView}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBox
                                        Width="34"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,2,0"
                                        Visibility="Collapsed"
                                        TextAlignment="Center"
                                        MouseDoubleClick="OnRankTextBoxMouseDoubleClick"
                                        PreviewKeyDown="OnRankTextBoxPreviewKeyDown"
                                        LostFocus="OnRankTextBoxLostFocus" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn
                        x:Name="iconGridViewColumn"
                        Header=""
                        Width="{StaticResource PlaylistIconColumnWidth}"
                        HeaderContainerStyle="{StaticResource iconHeaderContainerStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid
                                    Margin="{StaticResource PlaylistIconColumnChromeMargin}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                    <Canvas
                                            Width="{StaticResource PlaylistIconArtworkSize}"
                                            Height="{StaticResource PlaylistIconArtworkSize}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Image
                                            Style="{StaticResource imageIcon}"
                                            Canvas.Left="0"
                                            Canvas.Top="0"
                                            Stretch="Uniform"
                                            RenderOptions.BitmapScalingMode="Fant"
                                            Width="{StaticResource PlaylistIconArtworkSize}"
                                            Height="{StaticResource PlaylistIconArtworkSize}"
                                            Source="{Binding Icon, Mode=OneWay, Converter={StaticResource ImageStringToImageConverterCached}, FallbackValue={StaticResource DefaultGameIcon}}" />
                                        <Button
                                            Style="{StaticResource playlistIconPlayButtonStyleThemed}"
                                            Canvas.Left="0"
                                            Canvas.Top="0"
                                            Width="{StaticResource PlaylistIconArtworkSize}"
                                            Height="{StaticResource PlaylistIconArtworkSize}"
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.StartGameCommand}"
                                            CommandParameter="{Binding}" />
                                    </Canvas>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn
                        x:Name="nameGridViewColumn"
                        HeaderTemplate="{StaticResource nameHeaderTemplate}"
                        HeaderContainerStyle="{StaticResource nameHeaderContainerStyle}"
                        Width="500">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn
                        x:Name="playtimeGridViewColumn"
                        Width="168"
                        HeaderTemplate="{StaticResource playtimeHeaderTemplate}"
                        HeaderContainerStyle="{StaticResource playtimeHeaderContainerStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding Playtime, Converter={StaticResource playtimeValueConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn
                        x:Name="completionStatusGridViewColumn"
                        Width="174"
                        HeaderTemplate="{StaticResource completionHeaderTemplate}"
                        HeaderContainerStyle="{StaticResource completionHeaderContainerStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding CompletionStatus}" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn
                        x:Name="lastPlayedGridViewColumn"
                        Width="196"
                        HeaderTemplate="{StaticResource lastPlayedHeaderTemplate}"
                        HeaderContainerStyle="{StaticResource lastPlayedHeaderContainerStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding LastActivity, Converter={StaticResource lastPlayedValueConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn
                        x:Name="lastActivityGridViewColumn"
                        Width="196"
                        HeaderTemplate="{StaticResource lastActivityHeaderTemplate}"
                        HeaderContainerStyle="{StaticResource lastActivityHeaderContainerStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding Modified, Converter={StaticResource lastActivityValueConverter}}" />
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn
                        x:Name="howLongToBeatGridViewColumn"
                        Width="400"
                        HeaderTemplate="{StaticResource howLongToBeatHeaderTemplate}"
                        HeaderContainerStyle="{StaticResource howLongToBeatHeaderContainerStyle}"
                        CellTemplate="{StaticResource howLongToBeatColumn}" />
                </GridView>
            </ListView.View>
        </ListView>
        <TextBlock Style="{StaticResource noGamesText}" TextAlignment="Center" VerticalAlignment="Center" Text="{DynamicResource LOCPlaylist_EmptyPlaylistMessage}"/>
    </DockPanel>
</UserControl>